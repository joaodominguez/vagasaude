# Sito IT (offertesanita.it). Porta locale/produzione prevista: 3013.
NEXT_PUBLIC_SITE_URL=https://offertesanita.it

# Analytics: nessun valore di default nel codice. Se vuoti, GA4/Clarity non vengono caricati.
# Creare proprieta' dedicate per offertesanita.it (non riutilizzare quelle degli altri mercati).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Backoffice temporaneo (impostare credenziali proprie in produzione)
ADMIN_USER=
ADMIN_PASSWORD=

# Persistenza locale di avvisi e offerte (percorso proprio, diverso dagli altri mercati)
DATA_DIR=

# Modalita dello store offerte (come in ES): json (default) | dual | sqlite-dual | sqlite  (vedi src/lib/job-repository.ts)
# JOB_STORE=

# Token condiviso con gli scraper
SCRAPER_API_TOKEN=

# Email (facoltativo finche' il dominio di invio non e' configurato in Resend)
RESEND_API_KEY=
EMAIL_FROM=Offerte Sanità <avvisi@offertesanita.it>
