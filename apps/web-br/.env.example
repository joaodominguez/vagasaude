NEXT_PUBLIC_SITE_URL=https://vagasaude.com.br

# Google Analytics 4 (VagaSaúde Brasil only — do not reuse PT G-2FTGH5C1GQ)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-0Q3135XVVY

# Backoffice temporário (substituir por magic link quando o Resend estiver ligado)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-with-a-long-random-password

# Persistência local dos alertas e vagas nesta primeira versão
DATA_DIR=/var/www/vagasaude-br/data

# Token partilhado com os scrapers
SCRAPER_API_TOKEN=change-me-scraper-token

# Email (opcional até a conta Resend estar configurada)
RESEND_API_KEY=
EMAIL_FROM=VagaSaúde <alertas@vagasaude.com.br>
