NEXT_PUBLIC_SITE_URL=https://vagasaude.com.br

# Google Analytics 4 (VagaSaúde Brasil only — do not reuse PT G-2FTGH5C1GQ)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-0Q3135XVVY

# Backoffice temporário (substituir por magic link quando o Resend estiver ligado)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-with-a-long-random-password

# Persistência local dos alertas e vagas nesta primeira versão
DATA_DIR=/var/www/vagasaudebr/data

# Token partilhado com os scrapers (e com POST /api/alerts/digest)
SCRAPER_API_TOKEN=change-me-scraper-token

# Email via Resend (mesma conta PT ok; domínio BR tem de estar verificado)
# No dashboard Resend: Domains → Add vagasaude.com.br → SPF + DKIM (DNS).
# Sem DNS verificado, envios de alertas@vagasaude.com.br falham.
# Quote EMAIL_FROM (angle brackets break `source` in start.sh / run-scrapers.sh).
RESEND_API_KEY=
EMAIL_FROM="VagaSaúde Brasil <alertas@vagasaude.com.br>"
