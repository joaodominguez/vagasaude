# Sitio ES (vacantessalud.es) — dominio PENDIENTE de compra.
NEXT_PUBLIC_SITE_URL=https://vacantessalud.es

# GA4 / Clarity / AdSense: SIN valores por defecto en el código. Crear propiedades
# propias para vacantessalud.es (no reutilizar las de vagasaude.pt).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-FDWQFVL4J1  # ya es el valor por defecto en codigo
# NEXT_PUBLIC_CLARITY_PROJECT_ID=
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-...

# Backoffice temporal
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-with-a-long-random-password

# Persistencia local de alertas y ofertas (usar una ruta propia, distinta de PT/BR)
DATA_DIR=/var/www/vacantessalud/data

# Token compartido con los scrapers
SCRAPER_API_TOKEN=change-me-scraper-token

# Email (opcional hasta configurar el dominio de envío en Resend)
RESEND_API_KEY=
EMAIL_FROM=VacantesSalud <alertas@vacantessalud.es>
